#!name = 小红书去视频动态
#!desc = 过滤小红书信息流中的视频动态（去视频推流版）。仅隐藏feed中的视频，不影响点击播放。2026-07-28 v3.0.0
#!author = opencode
#!system = ios
#!date = 2026-07-28 v3.0.0
#!version = 3.0.0

[Script]
# ===== 诊断 + 信息流去视频动态 =====
http-response ^https?://edith\.xiaohongshu\.com/.* script-path=https://raw.githubusercontent.com/noodlespring/Loon-Config/main/script/xiaohongshu-video-filter.js, requires-body=true, tag=小红书过滤视频动态

[MITM]
hostname = *.xiaohongshu.com
