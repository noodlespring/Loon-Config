#!name = 小红书去视频推流
#!desc = 过滤小红书视频/直播推流+信息流视频动态。禁止QUIC走HTTP/2以便MITM拦截。2025-07-28 v3.0.0
#!author = opencode
#!system = ios
#!date = 2025-07-28 v3.0.0
#!version = 3.0.0

[Rule]
# ===== 强制HTTP/2(禁用QUIC) =====
# QUIC加密无法被MITM，强制降级到HTTP/2
PROTOCOL,QUIC,REJECT

# ===== VOD视频CDN =====
# 匹配 sns-video-bd.xhscdn.com / sns-video-hw.xhscdn.com 等动态视频子域名
AND,((DOMAIN-SUFFIX,xhscdn.com),(DOMAIN-KEYWORD,sns-video)),REJECT
AND,((DOMAIN-SUFFIX,xhscdn.net),(DOMAIN-KEYWORD,sns-video)),REJECT

# ===== 直播推流CDN =====
# 匹配 alive-*.xhscdn.com, alive2.xhscdn.com 等直播CDN
AND,((DOMAIN-SUFFIX,xhscdn.com),(DOMAIN-KEYWORD,alive)),REJECT
AND,((DOMAIN-SUFFIX,xhscdn.net),(DOMAIN-KEYWORD,alive)),REJECT

# ===== 独立直播域名 =====
DOMAIN-SUFFIX,xhslive.com,REJECT

# ===== 视频备用CDN =====
DOMAIN-SUFFIX,xhsrcdn.com,REJECT

[Script]
# ===== Content-Type兜底 =====
# 拦截所有漏网的 video/* 响应（依赖MITM）
http-response ^https?://[^/]+\.(xhscdn\.(com|net)|xiaohongshu\.com|xhsrcdn\.com)/.* script-path=block-xhs-video-by-header.js, tag=小红书视频流兜底

# ===== 信息流去视频动态 =====
http-response ^https?://edith\.xiaohongshu\.com/api/sns/web/v1/(feed|homefeed|recommend) script-path=xiaohongshu-video-filter.js, requires-body=true, tag=小红书过滤视频动态

[MITM]
hostname = *.xiaohongshu.com, *.xhscdn.com, *.xhscdn.net, *.xhsrcdn.com
