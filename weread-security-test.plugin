#!name=微信读书安全测试插件
#!desc=授权安全测试 — 复现微信读书/听书会员绕过攻击（仅用于漏洞验证与修复）
#!icon=https://raw.githubusercontent.com/deezertidal/private/main/icons/wxds.png
#!homepage=https://github.com/noodlespring/Loon-Config
#!author=Security Test (Authorized)
#!version=1.0.0

# =============================================================================
#  微信读书（WeRead）安全测试插件
#  用途：授权红客测试 — 模拟 MITM 响应篡改攻击
#  测试对象：i.weread.qq.com / i.at.qq.com 会员 API
#  修复目标：SSL Pinning + 响应完整性校验
# =============================================================================
#  安装方式：
#  1. Loon → 插件 → 安装本插件
#  2. 开启 Loon 的 MITM 解密
#  3. 安装并信任 CA 证书
#  4. 打开微信读书验证会员状态
# =============================================================================

[General]
# 仅用于测试，不添加额外规则

[Script]
# ==========================
# 攻击面 #1：微信读书无限卡解锁
# 拦截 /pay/memberCardSummary 响应，伪造会员状态
# ==========================
http-response ^https:\/\/i\.weread\.qq\.com\/pay\/memberCardSummary script-path=https://raw.githubusercontent.com/noodlespring/Loon-Config/refs/heads/main/script/weread-unlock.js, requires-body=true, timeout=10, tag=WeRead_Unlock

# ==========================
# 攻击面 #2：微信听书会员解锁
# 拦截 /pay/memberinfo 响应，伪造永久会员
# ==========================
http-response ^https:\/\/i\.at\.qq\.com\/pay\/memberinfo script-path=https://raw.githubusercontent.com/noodlespring/Loon-Config/refs/heads/main/script/wxts-unlock.js, requires-body=true, timeout=10, tag=WeRead_Audio_Unlock

[MITM]
hostname = i.weread.qq.com, i.at.qq.com
