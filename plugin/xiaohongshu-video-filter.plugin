#!name = 小红书去视频动态
#!desc = 过滤小红书首页推荐中的视频动态（支持iOS + Web）。2026-07-28 v4.0.0
#!author = opencode
#!system = ios
#!date = 2026-07-28
#!version = 4.0.0

[Script]
# ===== 小红书首页推荐去视频 =====
http-response ^https?://(rec|edith)\.xiaohongshu\.com/.* script-path=https://raw.githubusercontent.com/noodlespring/Loon-Config/main/script/xiaohongshu-video-filter.js, requires-body=true, tag=小红书去视频动态

[MITM]
hostname = *.xiaohongshu.com
