#!name = 小红书去视频推流
#!desc = 全量拦截小红书视频推流：Content-Type检测（任何视频域名） + 信息流视频动态过滤。需开启MITM
#!author = opencode
#!system = ios
#!date = 2025-07-28 v2.0.0
#!version = 2.0.0

[Rule]
# 强制HTTP/1.1或HTTP/2（QUIC不能被MITM）
PROTOCOL,QUIC,REJECT

[Script]
# ① 拦截所有返回 video/* 的响应（不缓冲body，轻量）
http-response ^https?://[^/]+\.(xiaohongshu|xhscdn|alikcdn)\.com/.* script-path=block-xhs-video-by-header.js, tag=小红书视频流阻断

# ② 过滤信息流中的视频笔记（需缓存body解析JSON）
http-response ^https?://edith\.xiaohongshu\.com/api/sns/web/v1/(feed|homefeed|recommend) script-path=xiaohongshu-video-filter.js, requires-body=true, tag=小红书过滤视频动态

[MITM]
hostname = *.xiaohongshu.com, *.xhscdn.com, *.alikcdn.com
